Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"blue", "=", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"0", ",", "0.447", ",", "0.698"}], "]"}]}], ";", 
   RowBox[{"verm", "=", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"0.835", ",", "0.369", ",", "0."}], "]"}]}], ";", 
   RowBox[{"red", "=", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"0.8", ",", "0.1", ",", "0.1"}], "]"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"colour", "-", 
    RowBox[{"blind", " ", "safe"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lab", "[", "e_", "]"}], ":=", 
   RowBox[{"Style", "[", 
    RowBox[{"e", ",", 
     RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ",", 
     RowBox[{"FontSize", "\[Rule]", "11"}], ",", "Black"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"it", "[", "s_", "]"}], ":=", 
   RowBox[{"Style", "[", 
    RowBox[{"s", ",", "Italic"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hue", "=", 
    RowBox[{
     RowBox[{"Blend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "blue"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "0.5"}], ",", 
           RowBox[{"Blend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"blue", ",", "White"}], "}"}], ",", "0.45"}], "]"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"GrayLevel", "[", "0.97", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0.5", ",", 
           RowBox[{"Blend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"verm", ",", "White"}], "}"}], ",", "0.45"}], "]"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "verm"}], "}"}]}], "}"}], ",", "#"}], "]"}], 
     "&"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"diverging", ",", " ", 
    RowBox[{
     RowBox[{"neutral", " ", "at", " ", "q"}], " ", "=", " ", "0"}]}], " ", 
   "*)"}]}]}], "Input",
 CellLabelAutoDelete->
  True,ExpressionUUID->"b13044d6-dd83-4a19-a688-e16b82beb252"],

