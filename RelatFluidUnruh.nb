Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["q", "max"], "=", 
    RowBox[{"Ceiling", "[", 
     RowBox[{
      RowBox[{"NMaxValue", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{"Abs", "[", 
            RowBox[{"q", "[", 
             RowBox[{"t", ",", "x"}], "]"}], "]"}], "w"], ",", 
          RowBox[{
           RowBox[{"0", "\[LessEqual]", "t", "\[LessEqual]", "tmax"}], "&&", 
           RowBox[{
            RowBox[{"-", "xmax"}], "\[LessEqual]", "x", "\[LessEqual]", 
            "xmax"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "x"}], "}"}]}], "]"}], ",", "0.01"}], "]"}]}], 
   ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"symmetric", " ", "colour", " ", "scale"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"grid", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"q", "[", 
       RowBox[{"t", ",", "x"}], "]"}], "w"], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"0", ",", "tmax", ",", "699"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"-", "xmax"}], ",", "xmax", ",", "699"}], "]"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pix", "=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"List", "@@", 
        RowBox[{"hue", "[", 
         RowBox[{"Clip", "[", 
          RowBox[{
           FractionBox["#", 
            SubscriptBox["q", "max"]], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], "]"}]}], "&"}], ",",
       "grid", ",", 
      RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "a", " ", "raster", " ", "keeps", " ", "the", " ", "file", " ", "small"}],
     ";", " ", 
    RowBox[{"the", " ", "frame", " ", "stays", " ", "vector"}]}], " ", 
   "*)"}]}]}], "Input",
 CellLabelAutoDelete->
  True,ExpressionUUID->"bf87390d-792b-44c2-8078-0d0f47825c20"],

