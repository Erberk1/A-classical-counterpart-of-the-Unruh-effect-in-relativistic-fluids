Cell["Causal heat transient", "Section",
 FontFamily->"Helvetica",
 FontSize->16,ExpressionUUID->"b56e36c1-02fa-407c-a0dd-09bbacfd45b5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Kappa]", "=", "0.8"}], ";", 
   RowBox[{
    SubscriptBox["c", "v"], "=", "1"}], ";", 
   RowBox[{
    SubscriptBox["\[Tau]", "q"], "=", "1"}], ";", 
   RowBox[{"w", "=", "1"}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"conductivity", ",", " ", 
    RowBox[{"heat", " ", "capacity"}], ",", " ", 
    RowBox[{"relaxation", " ", "time"}], ",", " ", "enthalpy"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"A", "=", "0.6"}], ";", 
   RowBox[{"\[Sigma]", "=", "1.5"}], ";", 
   RowBox[{
    SubscriptBox["x", "0"], "=", "2"}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"pulse", " ", "height"}], ",", " ", "width", ",", " ", 
    RowBox[{"probe", " ", "worldline"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"L", "=", "40"}], ";", 
   RowBox[{"tmax", "=", "12"}], ";", 
   RowBox[{"xmax", "=", "12"}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"box", ",", " ", 
    RowBox[{"run", " ", "time"}], ",", " ", 
    RowBox[{"plotted", " ", "window"}]}], " ", "*)"}]}]}], "Input",
 CellLabelAutoDelete->
  True,ExpressionUUID->"9c4716ce-35eb-4468-a3c7-eb738be02dc4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["v", "c"], "=", 
   SqrtBox[
    FractionBox["\[Kappa]", 
     RowBox[{
      SubscriptBox["c", "v"], " ", 
      SubscriptBox["\[Tau]", "q"]}]]]}], "   ", 
  RowBox[{"(*", 
   RowBox[{" ", 
    RowBox[{
     RowBox[{"second", " ", "sound"}], ",", " ", 
     RowBox[{
      RowBox[{"Eq", ".", " ", 
       RowBox[{"(", "A4", ")"}]}], ";", " ", 
