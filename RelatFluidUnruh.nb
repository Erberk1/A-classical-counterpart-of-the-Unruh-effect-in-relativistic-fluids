 CellLabel->"Out[4]=",ExpressionUUID->"cb5cbaf8-c613-4f87-ab38-9fa359509434"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"\[Delta]T", ",", "q"}], "]"}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "names", " ", "have", " ", "to", " ", "be", " ", "free", " ", 
    "before", " ", "they", " ", "are", " ", "solved", " ", "for"}], " ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "energy", " ", "balance", " ", "and", " ", "the", " ", "Maxwell"}], "\[Dash]", 
    RowBox[{"Cattaneo", " ", "law"}], ",", " ", 
    RowBox[{"Eq", ".", " ", 
     RowBox[{"(", "A7a", ")"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Delta]T", ",", "q"}], "}"}], "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["c", "v"], " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", "t"], 
          RowBox[{"\[Delta]T", "[", 
           RowBox[{"t", ",", "x"}], "]"}]}]}], "\[Equal]", 
        RowBox[{"-", 
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], 
          RowBox[{"q", "[", 
           RowBox[{"t", ",", "x"}], "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          SubscriptBox["\[Tau]", "q"], " ", 
          RowBox[{
           SubscriptBox["\[PartialD]", "t"], 
           RowBox[{"q", "[", 
            RowBox[{"t", ",", "x"}], "]"}]}]}], "+", 
         RowBox[{"q", "[", 
          RowBox[{"t", ",", "x"}], "]"}]}], "\[Equal]", 
        RowBox[{
         RowBox[{"-", "\[Kappa]"}], " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], 
          RowBox[{"\[Delta]T", "[", 
           RowBox[{"t", ",", "x"}], "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"\[Delta]T", "[", 
         RowBox[{"0", ",", "x"}], "]"}], "\[Equal]", 
        RowBox[{"A", " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"-", 
           FractionBox[
            SuperscriptBox["x", "2"], 
            RowBox[{"2", " ", 
             SuperscriptBox["\[Sigma]", "2"]}]]}]]}]}], ",", 
       RowBox[{
        RowBox[{"q", "[", 
         RowBox[{"0", ",", "x"}], "]"}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{"\[Delta]T", "[", 
         RowBox[{"t", ",", 
          RowBox[{"-", "L"}]}], "]"}], "\[Equal]", 
        RowBox[{"\[Delta]T", "[", 
         RowBox[{"t", ",", "L"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"q", "[", 
         RowBox[{"t", ",", 
          RowBox[{"-", "L"}]}], "]"}], "\[Equal]", 
        RowBox[{"q", "[", 
         RowBox[{"t", ",", "L"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Delta]T", ",", "q"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
     RowBox[{"Method", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<MethodOfLines\>\"", ",", 
        RowBox[{"\"\<SpatialDiscretization\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<TensorProductGrid\>\"", ",", 
           RowBox[{"\"\<MinPoints\>\"", "\[Rule]", "1600"}], ",", 
           RowBox[{"\"\<MaxPoints\>\"", "\[Rule]", "1600"}], ",", 
           RowBox[{"\"\<DifferenceOrder\>\"", "\[Rule]", "4"}]}], "}"}]}]}], 
       "}"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabelAutoDelete->
  True,ExpressionUUID->"08bcd63d-ab14-42df-8e9d-70589e89a35c"],

