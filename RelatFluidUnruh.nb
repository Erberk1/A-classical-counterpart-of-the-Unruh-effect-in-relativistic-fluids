Cell["Figure 2 \[LongDash] rapidity and thermodynamic acceleration", "Section",
 FontFamily->"Helvetica",
 FontSize->16,ExpressionUUID->"637a1ad4-e273-4168-bb68-8dfa86a1ac84"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
    FractionBox[
     RowBox[{"q", "[", 
      RowBox[{"t", ",", 
       SubscriptBox["x", "0"]}], "]"}], "w"]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "boost", " ", "velocity", " ", "seen", " ", "on", " ", "the", " ", "probe",
     " ", "worldline"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f1", "[", 
    RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["q", 
      TagBox[
       RowBox[{"(", 
        RowBox[{"1", ",", "0"}], ")"}],
       Derivative],
      MultilineFunction->None], "[", 
     RowBox[{"t", ",", 
      SubscriptBox["x", "0"]}], "]"}], "w"]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f2", "[", 
     RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
    FractionBox[
     RowBox[{
      SuperscriptBox["q", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"2", ",", "0"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"t", ",", 
       SubscriptBox["x", "0"]}], "]"}], "w"]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"taken", " ", "from", " ", "the", " ", "interpolation"}], ",", 
    " ", 
    RowBox[{
     RowBox[{"not", " ", "finite"}], "-", "differenced"}]}], " ", 
   "*)"}]}]}], "Input",
 CellLabelAutoDelete->
  True,ExpressionUUID->"d68bcc71-bf36-4084-b7ee-69d869994a57"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Eta]", "[", 
     RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"ArcTanh", "[", 
      RowBox[{"2", " ", 
       RowBox[{"f", "[", "t", "]"}]}], "]"}]}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"Eq", ".", " ", 
    RowBox[{"(", "21", ")"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["a", "th"], "[", 
     RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
    FractionBox[
     RowBox[{"f1", "[", "t", "]"}], 
     RowBox[{"1", "-", 
      RowBox[{"4", " ", 
       SuperscriptBox[
        RowBox[{"f", "[", "t", "]"}], "2"]}]}]]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"Eq", ".", " ", 
    RowBox[{"(", "22", ")"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    SuperscriptBox[
     SubscriptBox["a", "th"], "\[Prime]",
     MultilineFunction->None], "[", 
    RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"f2", "[", "t", "]"}], 
     RowBox[{"1", "-", 
      RowBox[{"4", " ", 
       SuperscriptBox[
        RowBox[{"f", "[", "t", "]"}], "2"]}]}]], "+", 
    FractionBox[
     RowBox[{"8", " ", 
      RowBox[{"f", "[", "t", "]"}], " ", 
      SuperscriptBox[
       RowBox[{"f1", "[", "t", "]"}], "2"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"4", " ", 
         SuperscriptBox[
          RowBox[{"f", "[", "t", "]"}], "2"]}]}], ")"}], "2"]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"R", "[", 
     RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
    FractionBox[
     RowBox[{"Abs", "[", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["a", "th"], "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}], "]"}], 
     SuperscriptBox[
      RowBox[{
       SubscriptBox["a", "th"], "[", "t", "]"}], "2"]]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"Eq", ".", " ", 
    RowBox[{"(", "23", ")"}]}], " ", "*)"}]}]}], "Input",
 CellLabelAutoDelete->
  True,ExpressionUUID->"6b3a7d4e-a443-4b9a-8b48-4f540a834f35"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tab", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"R", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0.3", ",", 
       RowBox[{"tmax", "-", "0.3"}], ",", "0.005"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   SubscriptBox["t", "min"], "=", 
   RowBox[{
    RowBox[{"MinimalBy", "[", 
     RowBox[{"tab", ",", "Last"}], "]"}], "\[LeftDoubleBracket]", 
    RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"runs", "=", 
    RowBox[{"Split", "[", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"tab", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Last", "[", "#", "]"}], "<", "1"}], "&"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
          "-", 
         RowBox[{
         "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], "<", 
        "0.02"}], "&"}]}], "]"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"contiguous", " ", "stretches", " ", "only"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"win", "=", 
   RowBox[{"SelectFirst", "[", 
    RowBox[{"runs", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "\[LeftDoubleBracket]", 
        RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "\[LessEqual]", 
       SubscriptBox["t", "min"], "\[LessEqual]", 
       RowBox[{"#", "\[LeftDoubleBracket]", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}]}], "&"}]}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"t1", ",", "t2"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"win", "\[LeftDoubleBracket]", 
      RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
     RowBox[{"win", "\[LeftDoubleBracket]", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Mean", "[", 
   RowBox[{
    SubscriptBox["a", "th"], "/@", 
    RowBox[{"Subdivide", "[", 
     RowBox[{"t1", ",", "t2", ",", "50"}], "]"}]}], "]"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "value", " ", "quoted", " ", "in", " ", "the", " ", 
    "caption"}], " ", "*)"}]}]}], "Input",
 CellLabelAutoDelete->
  True,ExpressionUUID->"a460c30d-dbf3-4b7f-95a2-aa1fc3e7f1a7"],

